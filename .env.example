# ---- Pagecraft server-side environment variables ----
# Used by the /api/generate serverless function. NEVER exposed to the browser.
#
# Local dev:  copy this file to ".env.local" and fill in your key, then run `vercel dev`.
# Production: set these in Vercel → Project → Settings → Environment Variables.

# Required — your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional — default model when the client doesn't specify one.
OPENAI_MODEL=gpt-4o

# Optional — OpenAI-compatible base URL (e.g. OpenRouter or a local LLM).
# OPENAI_BASE_URL=https://api.openai.com/v1
